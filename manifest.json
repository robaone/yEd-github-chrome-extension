{
    "manifest_version": 3,
    "name": "yEd-gitHub viewer",
    "version": "1.2",
    "description": "A browser extension to open .graphml files from GitHub in yEd Live.",
    "browser_specific_settings": {
        "gecko": {
            "id": "yed-github-viewer@robaone.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "permissions": [
        "tabs",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://github.com/*",
        "https://raw.githubusercontent.com/*"
    ],
    "background": {
        "scripts": ["background.js"],
        "service_worker": "background.js"
    },
    "action": {
        "default_icon": {
            "16": "images/yEd-github16.png",
            "32": "images/yEd-github32.png",
            "48": "images/yEd-github48.png",
            "128": "images/yEd-github128.png"
        }
    },
    "icons": {
        "16": "images/yEd-github16.png",
        "32": "images/yEd-github32.png",
        "48": "images/yEd-github48.png",
        "128": "images/yEd-github128.png"
    }
}
